# ---- Core ----
NODE_ENV=development
PORT=4000

# ---- MongoDB Atlas (REQUIRED) ----
# Create a free cluster at https://cloud.mongodb.com, add a database user,
# allow network access for your machine / Render egress, then paste the URI.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/smart-family?retryWrites=true&w=majority

# ---- Security (REQUIRED) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-min-16-chars
JWT_EXPIRES_IN_DAYS=30

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---- Gemini AI (optional — required for the AI assistant) ----
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- LiveKit calling (optional — required for real audio/video calls) ----
# https://cloud.livekit.io
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Google sign-in (optional — required for "Sign in with Google") ----
# 1. console.cloud.google.com → APIs & Services → OAuth consent screen
# 2. Create OAuth client ID (Web application).
# 3. Authorized redirect URI: https://YOUR-SERVER/api/auth/google/callback
#    (for local dev: http://localhost:4000/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: override the callback URL sent to Google if the server sits behind a proxy
# whose externally visible origin differs from the request host.
# GOOGLE_REDIRECT_URI=

# ---- Logging ----
LOG_LEVEL=info

# -- Platform Super Admin bootstrap (server-side script only) ---------------
# Set privately (never in code/GitHub/argv). Required by scripts/create-super-admin.mjs
# ADMIN_BOOTSTRAP_TOKEN=<32+ random characters>
