# ---- Core ----
NODE_ENV=development
PORT=4000

# ---- MongoDB Atlas (REQUIRED) ----
# Create a free cluster at https://cloud.mongodb.com, add a database user,
# allow network access for your machine / Render egress, then paste the URI.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/smart-family?retryWrites=true&w=majority

# ---- Security (REQUIRED) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-min-16-chars
JWT_EXPIRES_IN_DAYS=30

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---- Gemini AI (optional — required for the AI assistant) ----
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- LiveKit calling (optional — required for real audio/video calls) ----
# https://cloud.livekit.io
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Logging ----
LOG_LEVEL=info
